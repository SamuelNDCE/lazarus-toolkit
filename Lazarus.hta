<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Lazarus</title>
<hta:application id="app"
  applicationname="Lazarus"
  border="thin"
  caption="yes"
  maximizebutton="no"
  minimizebutton="yes"
  scroll="no"
  singleinstance="yes"
  windowstate="normal">
<style>
/* NeuralVault light tokens, hardcoded (MSHTML has no CSS custom properties).
   bg #eceae4 / s1 #fbfbfa / s2 #ffffff / s3 #f1f1ef
   text #17181a / #5c606a / #7a7f88 -- accent #0b6182 -- radii 3/5/7

   Vertical budget for an 880px window:
     head 74 + tree(flex) + detail 200 + foot 52
   detail/foot are sized against their tallest real content, measured, so
   nothing clips and neither pane ever needs a scrollbar. */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
body {
  background: #eceae4; color: #17181a;
  font-family: "Segoe UI", "Inter", Tahoma, sans-serif;
  font-size: 13px; line-height: 1.45;
}

#head {
  position: absolute; left: 0; right: 0; top: 0; height: 74px;
  background: #fbfbfa; border-bottom: 1px solid rgba(0,0,0,0.14);
  padding: 7px 12px 0 12px;
}
#bn { font-size: 14px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; }
#bs { font-size: 11px; color: #7a7f88; line-height: 1.25; margin-top: 1px; }
#rfsh {
  position: absolute; right: 11px; top: 8px;
  width: 26px; height: 26px; line-height: 24px; text-align: center;
  border: 1px solid rgba(0,0,0,0.14); border-radius: 5px;
  background: #ffffff; color: #5c606a; font-size: 15px; cursor: pointer;
}
#rfsh:hover { background: #f1f1ef; color: #0b6182; border-color: #0b6182; }
#rfsh.busy { background: #0b6182; color: #ffffff; border-color: #0b6182; }
#rfsh.stale { background: #9d1f18; color: #ffffff; border-color: #9d1f18; }
#sw { margin-top: 6px; position: relative; }
#mag { position: absolute; left: 7px; top: 5px; font-size: 11px; color: #7a7f88; }
#search {
  width: 100%; height: 24px; padding: 2px 8px 2px 22px;
  background: #ffffff; color: #17181a;
  border: 1px solid rgba(0,0,0,0.14); border-radius: 5px;
  font-family: inherit; font-size: 12px; outline: none; line-height: 20px;
}
#search:focus { border-color: #0b6182; }

#tree {
  position: absolute; left: 0; right: 0; top: 74px; bottom: 264px;
  background: #fbfbfa; overflow-y: auto; overflow-x: hidden; padding: 5px 0 8px 0;
}
.grp {
  padding: 6px 12px; cursor: pointer; font-size: 11px; font-weight: 700;
  color: #17181a; letter-spacing: .02em; text-transform: uppercase;
}
.grp:hover { background: #f1f1ef; }
.chev { display: inline-block; width: 11px; color: #7a7f88; font-size: 9px; }
.gc { float: right; color: #7a7f88; font-weight: 400; font-size: 11px; text-transform: none; }
.kids { display: block; }
.kids.cl { display: none; }
.leaf {
  padding: 3px 12px 3px 8px; cursor: pointer; font-size: 12px; color: #5c606a;
  border-left: 1px solid rgba(0,0,0,0.14); margin-left: 17px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ico { width: 16px; height: 16px; vertical-align: -3px; margin-right: 7px; }
.ico.disc {
  display: inline-block; width: 16px; height: 16px; margin-right: 7px;
  text-align: center; color: #a8adb8; font-size: 13px; vertical-align: -2px;
}
.bigico { width: 32px; height: 32px; float: left; margin: 0 10px 0 0; }
.bigico.disc {
  display: block; width: 32px; height: 32px; float: left; margin: 0 10px 0 0;
  text-align: center; line-height: 32px; color: #a8adb8; font-size: 26px;
}
.leaf:hover { background: #f1f1ef; color: #17181a; }
.leaf.sel { background: #ffffff; color: #17181a; font-weight: 600; border-left: 1px solid #0b6182; }
.leaf.gone { color: #9d1f18; }
.pin { float: right; font-size: 10px; color: #7a7f88; font-weight: 400; }

#detail {
  position: absolute; left: 0; right: 0; bottom: 52px; height: 212px;
  background: #ffffff; border-top: 1px solid rgba(0,0,0,0.14);
  padding: 10px 12px; overflow: hidden;
}
#empty { text-align: center; padding-top: 34px; }
#eicon { font-size: 30px; color: #c9ccd4; line-height: 1; }
#etitle { font-size: 15px; font-weight: 600; color: #5c606a; margin-top: 14px; letter-spacing: -0.01em; }
#ehint {
  font-size: 11px; color: #7a7f88; margin: 7px auto 0 auto;
  max-width: 310px; line-height: 1.55;
}
/* Title block is measured to match the 32px icon exactly, so the purpose line
   sits flush with the icon's bottom edge:
   #dn 15px x 1.2 = 18.0  +  #dfor 11px x 1.25 = 13.75  =  31.75 ~ 32px */
#dn { font-size: 15px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
#dfor { font-size: 11px; color: #0b6182; font-weight: 600; line-height: 1.25; margin-top: 0; }
#dd { font-size: 11px; color: #5c606a; line-height: 1.45; margin-top: 8px; height: 62px; overflow: hidden; clear: both; }
#dmeta { font-size: 10px; color: #7a7f88; margin-top: 5px; line-height: 1.3; }
#dmeta b { color: #17181a; font-weight: 600; }
#dpath {
  font-family: "Cascadia Mono", Consolas, monospace; font-size: 10px;
  color: #7a7f88; margin-top: 4px; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
#drow { margin-top: 9px; height: 26px; }
#run {
  float: right; background: #0b6182; color: #ffffff;
  border: 1px solid #0b6182; border-radius: 5px;
  padding: 4px 15px; font-size: 12px; font-weight: 600; cursor: pointer;
}
#run:hover { background: #0a5875; border-color: #0a5875; }
#run.dead { background: #f1f1ef; color: #7a7f88; border-color: rgba(0,0,0,0.14); cursor: default; }
#dexp {
  display: inline-block; font-size: 11px; color: #0b6182; cursor: pointer;
  border: 1px solid rgba(0,0,0,0.14); border-radius: 5px; padding: 4px 11px;
  background: #fbfbfa;
}
#dexp:hover { background: #f1f1ef; }
.tag {
  display: inline-block; font-size: 10px; font-weight: 600;
  border-radius: 3px; padding: 1px 6px; margin-left: 6px; vertical-align: 2px;
}
.t-info { background: rgba(11,97,130,0.12); color: #0b6182; }
.t-warn { background: rgba(122,66,0,0.12);  color: #7a4200; }
.t-dang { background: rgba(157,31,24,0.12); color: #9d1f18; }
.t-ok   { background: rgba(18,94,39,0.12);  color: #125e27; }

#foot {
  position: absolute; left: 0; right: 0; bottom: 0; height: 46px;
  background: #fbfbfa; border-top: 1px solid rgba(0,0,0,0.14); padding: 9px 12px;
}
/* Bar and stats stop short of the eject square rather than running under it. */
#barwrap {
  height: 6px; background: #f1f1ef; border: 1px solid rgba(0,0,0,0.14);
  border-radius: 999px; overflow: hidden; margin-right: 46px;
}
#bar { height: 100%; width: 0; background: #0b6182; }
#bar.warn { background: #7a4200; }
#bar.full { background: #9d1f18; }
#stat { font-size: 11px; color: #7a7f88; margin-top: 6px; line-height: 1.3; padding-right: 46px; }
#stat b { color: #17181a; font-weight: 700; }
#statr { float: right; }
/* Eject: square, right-hand end of the footer, diagonally opposite Refresh in
   the header. Refresh is safe and frequent; eject is final and rare, so they
   are kept far apart on purpose. Red at rest using the danger token, solid on
   hover, because this is the one control that ends the session. */
#ejectbtn {
  position: absolute; right: 10px; top: 4px;
  width: 38px; height: 38px; line-height: 36px; text-align: center;
  font-size: 17px; color: #9d1f18; cursor: pointer;
  border: 1px solid rgba(157,31,24,0.45); border-radius: 5px;
  background: rgba(157,31,24,0.12);
}
#ejectbtn:hover { background: #9d1f18; border-color: #9d1f18; color: #ffffff; }
/* Admin slider, in the HEADER beside rescan.
   It lived in the footer and was invisible: #barwrap and #stat come
   after it in the DOM and painted straight over it. The footer is a
   46px strip already carrying a bar, status text and eject, so the
   header is simply the right place for it. */
#admwrap {
  position: absolute; right: 45px; top: 7px;
  width: 40px; text-align: center; cursor: pointer;
}
#admsw {
  width: 34px; height: 16px; margin: 0 auto; position: relative;
  background: #c9ccd2; border-radius: 999px;
  border: 1px solid rgba(0,0,0,0.14);
  /* Slides rather than jumps. The knob moving is the feedback that the
     click registered, so it is worth the 160ms. */
  transition: background-color 160ms ease, border-color 160ms ease;
}
#admknob {
  position: absolute; top: 1px; left: 1px;
  width: 12px; height: 12px; border-radius: 999px; background: #ffffff;
  box-shadow: 0 1px 2px rgba(0,0,0,0.3);
  transition: left 160ms ease;
}
#admlbl {
  font-size: 8px; letter-spacing: 0.5px; color: #7a7f88;
  margin-top: 1px; line-height: 1.1;
}
/* ON is deliberately loud. Everything launching elevated is a real
   change in behaviour and should never be something you forgot. */
#admwrap.on #admsw { background: #0b6182; border-color: #0b6182; }
#admwrap.on #admknob { left: 19px; }
#admwrap.on #admlbl { color: #0b6182; font-weight: bold; }
#ejectbtn.busy {
  background: #9d1f18; border-color: #9d1f18; color: #ffffff;
  font-size: 9px; line-height: 12px; padding-top: 7px;
}
</style>
</head>

<body>

<div id="head">
  <div id="admwrap" onclick="toggleAdmin()" title="ON: every tool you launch runs as administrator. Leave it on for locked-down machines, where an AppLocker policy blocks anything run from this stick unless it is elevated.">
    <div id="admsw"><div id="admknob"></div></div>
    <div id="admlbl">ADMIN</div>
  </div>
  <div id="rfsh" onclick="refresh()" title="Re-scan the drive and rebuild this list">&#8635;</div>
  <div id="bn">Lazarus</div>
  <div id="bs">portable &middot; nothing installs to the host</div>
  <div id="sw"><span id="mag">&#128269;</span><input type="text" id="search" onkeyup="filter(event)"></div>
</div>

<div id="tree"></div>

<div id="detail">
  <div id="empty">
    <div id="eicon">&#9781;</div>
    <div id="etitle">Pick a tool to get started</div>
    <div id="ehint">Click anything on the left to see what it does and how much space it takes.
      Double-click to launch it straight away.</div>
  </div>
  <div id="body" style="display:none">
    <div id="dn"></div>
    <div id="dfor"></div>
    <div id="dd"></div>
    <div id="dmeta"></div>
    <div id="dpath"></div>
    <div id="drow"></div>
  </div>
</div>

<div id="foot">
  <div id="ejectbtn" onclick="eject()" title="Eject: checks nothing is running, then safely removes this drive">&#9167;</div>
  <div id="barwrap"><div id="bar"></div></div>
  <div id="stat"><span id="statl"></span><span id="statr"></span></div>
</div>

<script language="JScript">
var shell = new ActiveXObject("WScript.Shell");
var fso   = new ActiveXObject("Scripting.FileSystemObject");

function baseDir(){
  var p = location.href.replace(/^file:\/+/, "");
  p = decodeURIComponent(p).replace(/\//g, "\\");
  return p.substring(0, p.lastIndexOf("\\"));
}
var BASE = baseDir();

/* name, path, PURPOSE, description, tag, tagclass */
var DATA = [
["Malware &amp; Forensics", [

 ["Malwarebytes","Tools\\Malwarebytes\\MBSetup.exe","Full scan and clean, always current",
  "INSTALLS Malwarebytes, it is not portable. Detections refresh whenever it is online, so it never goes stale. The portable 18-tool Toolset needs TechBench Advanced; the free tier is home use only. See Docs LICENCES.txt. AdwCleaner is the free portable one.","licence","t-warn"],
 ["Autoruns","Tools\\Sysinternals\\Autoruns64.exe","Find how malware survives reboots",
  "Lists every autostart hook Windows has: run keys, services, scheduled tasks, drivers, shell extensions, codecs. Submits hashes to VirusTotal live, so it flags current threats however old this copy is.","VT","t-info"],
 ["Process Explorer","Tools\\Sysinternals\\procexp64.exe","Identify a suspicious running process",
  "Task Manager with a parent-child tree, loaded DLLs, open handles and network connections. Right-click any process to check it against VirusTotal.","VT","t-info"],
 ["Activity Log","Tools\\ActivityLog\\Activity-Log.bat","See what has been done on a machine",
  "Reads what Windows quietly keeps even when auditing was never on: UserAssist, which records every program a user launched and when, plus Prefetch and the Security log. Then offers to switch on real auditing, including command lines, going forward.","",""],
 ["Process Monitor","Tools\\Sysinternals\\Procmon64.exe","Work out what a program is actually doing",
  "Live capture of every file, registry, network and process event. The tool for 'why does this fail' and 'what is it touching'. Filter hard or it will drown you.","",""],
 ["ADWCleaner","Tools\\ADWCleaner\\adwcleaner.exe","Strip adware, toolbars and hijacked browsers",
  "Targets PUPs, bundled junk, hijacked search providers and rogue extensions. Covers the category general antivirus deliberately ignores.","live","t-ok"],

 ["TCPView","Tools\\Sysinternals\\tcpview64.exe","See what a process is talking to",
  "Live list of every TCP and UDP connection with the process that owns it. The fast way to answer 'what is this thing phoning home to'. Colours new and dying connections, resolves addresses, and can end a connection or kill its process outright.","",""]
]],
["Drive Health &amp; Recovery", [
 ["Restore Point","Tools\\RestorePoint\\Restore-Point.bat","Make a rollback point before you start",
  "Windows 11 ships with System Protection OFF, so most machines have nothing to roll back to. This turns it on if needed and makes a point, in under a minute. Run it before you change anything. Roll back later with rstrui.exe.","",""],
 ["Health Report and Repair","Tools\\Health-Report.bat","Full checkup, then fix what it found",
  "Reads what Windows already knows and gives a verdict: battery wear, disk health, RAM, activation, Defender, firewall, BitLocker, BIOS age, installed programs, and every driver with its age. Then offers repairs: SFC, DISM, chkdsk, Windows Update, driver installs.","",""],
 ["CrystalDiskInfo","Tools\\CrystalDiskInfo\\DiskInfo64.exe","See drive health at a glance",
  "Reads SMART and gives one colour-coded verdict per drive, Good, Caution or Bad, with temperature, power-on hours and reallocated sector count. The fast answer to whether a disk is dying. GSmartControl runs the deeper self-tests when it says Caution.","",""],
 ["QPhotoRec","Tools\\TestDisk\\testdisk-7.2\\qphotorec_win.exe","Recover deleted files from a wrecked disk",
  "Carves files by signature, ignoring the filesystem entirely. Works even after a format. The console build photorec_win.exe sits in the same folder if you ever need finer control.","",""],
 ["Linux Reader","Tools\\LinuxReader\\LinuxReader64.exe","Read a NAS disk from inside Windows",
  "Opens ZFS, ext2/3/4, XFS, Btrfs and APFS volumes that Windows shows as raw unformatted space, and copies files off them. The fast route to a file on a TrueNAS pool with no reboot. Read-only, so it cannot harm the pool. Freeware, signed, not open source.","",""],
 ["HxD","Tools\\HxD\\app\\HxD64.exe","Edit raw disks, RAM and boot sectors",
  "Hex editor that opens physical drives and live memory as if they were files, which is the whole reason to carry one on a repair stick: MBR, GPT, partition tables and boot sectors. Opens files up to 8 EB instantly. Also does checksums, file compare and secure shredding.","",""]
]],
["Hardware Diagnostics", [
 ["HWiNFO64","Tools\\HWiNFO\\HWiNFO64.exe","Read every sensor accurately",
  "The most complete and accurate sensor readout available: per-core clocks and temperatures, VRM, power draw, drive health, fan curves. Free for personal and non-commercial use; commercial work needs their Pro licence.","licence","t-warn"],
 ["GPU-Z","Tools\\GPU-Z\\GPU-Z.2.70.0.exe","Identify and verify a graphics card",
  "GPU model, memory type and vendor, BIOS version, PCIe link speed and live sensors. Its BIOS dump and fake-card detection help on second-hand hardware.","",""]
]],
["Drivers", [
 ["Display Driver Uninstaller","Tools\\DDU\\DDU v18.1.5.6\\Display Driver Uninstaller.exe","Fix graphics corruption a reinstall won't",
  "Completely removes GPU drivers including registry entries and leftover files a normal uninstall leaves behind. The fix for black screens, artefacts and failed driver upgrades. Run in Safe Mode.","safe","t-warn"],
 ["DriverStore Explorer","Tools\\DriverStoreExplorer\\Rapr.exe","Purge old driver packages",
  "REMOVES drivers, it does not install them. Windows never deletes superseded drivers, so the DriverStore quietly grows to many GB of obsolete versions. This lists every package, flags the unused ones and deletes them. Use Snappy to install. Open source (GPL-2.0).","",""]
]],
["Network &amp; Remote", [
 ["WinSCP","Tools\\WinSCP\\portable\\WinSCP.exe","Move files to and from Linux boxes",
  "Dual-pane SFTP, SCP and FTP client. The everyday way in and out of Proxmox and TrueNAS hosts, with an editor for remote config files.","",""],
 ["WindTerm","Tools\\WindTerm\\WindTerm_2.7.0\\WindTerm.exe","Get a shell on a server or switch",
  "SSH, SFTP, telnet and serial in one window, with tabs and split panes. Replaced PuTTY, whose interface is one session per window and unchanged since 1999. The serial console matters for switches, routers and headless boxes with no network.","",""],
 ["Angry IP Scanner","Tools\\AngryIPScanner\\ipscan-3.9.3.exe","Quick sweep for live hosts",
  "Fast subnet ping sweep with hostnames and open ports. The network-discovery tool here: unlike Nmap it needs no Npcap driver installed on the machine you are working on, so it just runs. Shows live hosts, hostnames and common open ports.","",""],
 ["Firefox","Tools\\Firefox\\Firefox-Portable.bat","Browse from a clean, separate browser",
  "A hijacked or simply broken browser is normal on an infected machine, and you still need to fetch a driver or a tool. This runs off the stick with its profile kept here, so it leaves nothing on the host and inherits none of that machine's extensions or proxy settings.","",""]
]],
["Files &amp; Utilities", [
 ["Double Commander","Tools\\DoubleCommander\\doublecmd\\doublecmd.exe","Move and compare files properly",
  "Dual-pane file manager: two folders side by side, batch rename, folder sync and compare, built-in archive handling, and it can run elevated to reach paths Explorer refuses. Open source (GPL-2.0).","",""],
 ["Everything","Tools\\Everything\\everything.exe","Find any file instantly by name",
  "Indexes the entire MFT and returns matches as you type. Locate a config, log or stray installer across a whole machine without knowing where it lives.","",""],
 ["WizTree","Tools\\WizTree\\WizTree64.exe","Find what filled a drive, in seconds",
  "Reads the NTFS Master File Table directly instead of walking folders, so it maps a full disk in seconds where WinDirStat takes many minutes. The free build is personal use only: the vendor states commercial use is not allowed, so paid client work needs their licence.","licence","t-warn"],
 ["7-Zip","Tools\\7-Zip\\portable\\7zFM.exe","Open literally any archive",
  "Handles 7z, zip, rar, iso, wim, and extracts most installers directly. 7zr.exe alongside is a single-file extractor needing no install at all.","",""],
 ["Notepad++","Tools\\NotepadPlusPlus\\notepad++.exe","Edit config and log files properly",
  "Syntax highlighting, huge-file handling, regex find-and-replace across a folder, and correct Unix line-ending handling, which Notepad still mangles.","",""],
 ["BCUninstaller","Tools\\BCUninstaller\\BCUninstaller.exe","Rip out bloatware, properly",
  "Lists everything installed including Store apps, Steam games and orphaned entries, uninstalls many at once, then hunts the leftover files and registry keys the vendor's own uninstaller abandoned. Open source, so it has no upsell and no licence limit on client work.","",""],
 ["Win11Debloat","Tools\\Win11Debloat\\Run.bat","Strip bloat from a laptop you are setting up",
  "Removes preinstalled apps, disables telemetry and declutters Start, Explorer and the taskbar. Numbered menu, elevates itself, nothing installs. The time-saver when you are doing the same cleanup on laptop after laptop. Works on Windows 10 and 11.","",""],
 ["Dism++","Tools\\DismPlusPlus\\Dism++x64.exe","Repair and clean up Windows itself",
  "A GUI over DISM. Runs RestoreHealth against a corrupt component store, strips superseded updates and the WinSxS bloat Disk Cleanup will not touch, manages drivers and boot entries, and edits an offline Windows image. MIT licensed. Needs an admin prompt.","",""],
 ["BleachBit","Tools\\BleachBit\\BleachBit-Portable\\bleachbit.exe","Reclaim space and clear traces",
  "Clears caches, temp files, logs and browser history across many applications. Open source, so what it deletes is auditable.","",""],
 ["Rufus","Tools\\Rufus\\rufus-4.15p.exe","Write a bootable USB from an ISO",
  "Creates bootable installers and rescue media. Also the way to wipe and repartition a stubborn USB stick Windows refuses to format.","",""]
]],
["Temporary", [

 ["1. Choose Build Options","Setup\\Choose-Build.bat","Pick once, then every laptop builds the same",
  "DO THIS FIRST, once, before any laptop. Tick extra software to install, anything to uninstall from laptops already built, and whether to run a health report at the end. Every build then uses those answers and only asks for the two passwords. Safe to re-run.","temp",""],
 ["2. Club Laptop Build","Setup\\Run-Setup.bat","Provision a laptop for the coding club",
  "The full club build: accounts, software, Chrome policy, AppLocker, auditing and desktop shortcuts, in one run. About 25 minutes. Checks the disk first and warns if it looks to be failing. Asks two passwords and whether this is the teacher laptop, then runs to the end.","temp","t-warn"],
 ["3. Check Club Build","Setup\\Verify-Club.bat","Check a built laptop and repair what drifted",
  "Checks accounts, software, filtering, lockdown, auditing, and whether the teacher machine can reach this laptop. Installs what is ticked and missing, removes what is ticked for removal. Changes nothing until you say yes. Run on the first laptop before the rest.","temp",""],
 ["4. Gather Logs from Laptop","Setup\\Gather-Logs.bat","Bring a built laptop's logs onto the stick",
  "Run this ON A BUILT LAPTOP to copy its build and check logs back onto the stick, filed under the machine name. A build run from a copy leaves its logs on that laptop, so without this they never come back for review. Copies only.","temp",""],
 ["5. Collect Machine Evidence","Setup\\Collect-Evidence.bat","What Windows and the firmware recorded",
  "Run on a laptop that misbehaved: switched itself off, showed a firmware warning at boot, blue screened, or failed an install with no reason given. Collects HP Sure Start events, shutdowns, crashes, disk errors, installer failures and the battery. Read only.","temp",""],
 ["6. Repair Admin Tools","Setup\\Repair-AdminTools.bat","Fix the Admin Tools shortcuts on a laptop",
  "Run on a laptop that is ALREADY BUILT if a desktop Admin Tools shortcut opens and closes instantly, or says it is not running as administrator. Refreshes the deployed tools from this stick and rebuilds the shortcuts so they elevate. Takes seconds, rebuilds nothing.","temp",""],
 ["Copy Setup to a Laptop","Setup\\Make-Portable.bat","Put the build folder on the machine itself",
  "Copies the whole Setup folder to the laptop so the build can run without the stick plugged in, and verifies the copy by file list and total size rather than assuming it worked. Your saved build choices travel with it.","temp",""]
]],
["Boot ISOs", [

 ["Hiren's BootCD PE","ISO\\Windows\\HBCD_PE_x64.iso","Windows will not boot at all",
  "Bootable Windows 11 PE with about 90 free tools. Your environment when the installed Windows cannot start. Reboot and choose it from the Ventoy menu.","boot","t-warn"],
 ["Kaspersky Rescue","ISO\\Rescue\\KasperskyRescueDisk.iso","Kill malware that survives inside Windows",
  "Scans with Windows shut down, so rootkits and ransomware cannot hide or fight back. Downloads current definitions on boot. The last resort that usually works.","boot","t-warn"],
 ["SystemRescue 13.02","ISO\\Linux\\systemrescue-13.02-amd64.iso","Repair Linux filesystems and partitions",
  "Full Linux toolkit: GParted, ddrescue, LVM, ext4, XFS and btrfs repair, plus qemu-img for VM disk images. Everything Windows PE cannot read.","boot","t-warn"],
 ["Rescuezilla 2.6.2","ISO\\Rescue\\rescuezilla-2.6.2-64bit.iso","Image or clone a whole drive",
  "Point-and-click disk imaging and cloning, Clonezilla-compatible. Take a full image before attempting any risky repair.","boot","t-warn"],
 ["MemTest86+ 8.10","ISO\\Rescue\\MemTest86plus-8.10-x86_64.iso","Prove whether RAM is faulty",
  "Boots without an OS so it can test all memory. An in-Windows tester cannot check RAM the OS is holding, which is why those give false passes.","boot","t-warn"],
]]
];

var FLAT = [], SEL = -1, SZCACHE = {};

/* What each pin means, shown on hover in both the tree and the detail pane. */
var TAGDEF = {
  "VT"   : "Checks files against VirusTotal live, so it stays current however old this copy is.",
  "live" : "Downloads current definitions when it launches. Needs internet.",
  "AV"   : "Antivirus will flag this. Expected: it contains genuine password-recovery tools.",
  "cli"  : "Command line only. Opens a console window, no graphical interface.",
  "safe" : "Run this from Windows Safe Mode or it cannot do its job properly.",
  "boot" : "Not launchable from here. Reboot and pick it from the Ventoy menu.",
  "set"  : "A collection, not a single program. Opens a folder of tools.",
  "10 days" : "Expires 10 days after download and refuses to run rather than scanning with stale definitions. Re-download before a job.",
  "licence" : "Licensing caveat for commercial or paid client work. Read the description.",
  "temp" : "For the job in hand, not part of the permanent repair kit. Delete the Setup folder when the batch is finished.",
  "found" : "Not in the launcher's own list. Found in the Tools folder and added automatically, so its category and description are guesses."
};
function tagTitle(tag){ return TAGDEF[tag] ? TAGDEF[tag] : ""; }

/* MUST match Get-Slug in Tools\Get-Icons.ps1. If the two ever disagree
   the launcher looks for a filename that script never writes, every
   icon quietly becomes a glyph, and nothing reports a fault. */
function slug(name){
  return name.toLowerCase().replace(/&amp;/g, "&").replace(/[^a-z0-9]/g, "");
}

/* Icons are EXTRACTED from each tool's own binary by Tools\Get-Icons.ps1
   and cached in .\Icons, which is gitignored. There is no hand-kept map
   of name to filename any more: a tool dropped on the stick gets its own
   icon on the next refresh without anyone editing anything.

   Existence is checked rather than assumed, because the cache is built
   from whatever is actually plugged in. A tool that is not on this stick
   has no icon to extract, and a broken <img> looks worse than a glyph. */
var ICONHIT = {};
function iconFile(name){
  var s = slug(name);
  if (ICONHIT[s] === undefined) {
    try { ICONHIT[s] = fso.FileExists(BASE + "\\Icons\\" + s + ".png"); }
    catch (e) { ICONHIT[s] = false; }
  }
  return ICONHIT[s] ? ("Icons/" + s + ".png") : null;
}
function iconTag(name, cls){
  var f = iconFile(name);
  if (f) { return '<img class="' + cls + '" src="' + f + '">'; }
  return '<span class="' + cls + ' disc">&#9673;</span>';
}

function fmt(b){
  if (b >= 1073741824) { return (Math.round(b / 107374182.4) / 10) + " GB"; }
  if (b >= 1048576)    { return (Math.round(b / 104857.6) / 10) + " MB"; }
  if (b >= 1024)       { return Math.round(b / 1024) + " KB"; }
  return b + " B";
}

/* Report the size of the whole tool, not its launcher exe: WinMergeU.exe is
   4 MB but WinMerge is 78 MB. Folder walks are slow on USB, so cache. */
function toolRoot(rel){
  var p = rel.split("\\");
  if (p.length < 2) { return null; }
  return p[0] + "\\" + p[1];
}
function toolSize(t){
  var key = t.iso ? t.rel : toolRoot(t.rel);
  if (key === null) { return -1; }
  if (SZCACHE[key] !== undefined) { return SZCACHE[key]; }
  var v = -1;
  try {
    if (t.iso) { v = fso.GetFile(BASE + "\\" + t.rel).Size; }
    else { v = fso.GetFolder(BASE + "\\" + key).Size; }
  } catch (e) { v = -1; }
  SZCACHE[key] = v;
  return v;
}

/* ---------------------------------------------------------------------------
   TOOLS NOBODY LISTED

   Anything dropped into Tools\ shows up on the next refresh, launchable,
   with its own icon, without touching this file. Adding a tool is one
   step: copy the folder in.

   An entry in DATA is still worth writing, because that is where the
   category, the plain-English purpose and the licence pin come from, and
   none of those can be guessed from a folder. So discovery does not
   replace the table: it catches what the table has not got round to, and
   says so on screen rather than pretending the tool was always known.

   Windows forbids < > : " | ? * in a filename, so a folder name cannot
   break the markup it is interpolated into and needs no escaping.
   --------------------------------------------------------------------------- */
function knownFolders(){
  var seen = {};
  for (var g = 0; g < DATA.length; g++) {
    for (var i = 0; i < DATA[g][1].length; i++) {
      var p = DATA[g][1][i][1].split("\\");
      if (p.length > 1 && p[0].toLowerCase() === "tools") { seen[p[1].toLowerCase()] = true; }
    }
  }
  return seen;
}

/* Biggest exe wins, because portable builds ship helpers (crash
   handlers, updaters, language tools) alongside the real program and
   the real program is almost always the largest. Depth is capped: a
   folder walk on USB is slow, and nothing nests its main binary four
   levels down. */
function biggestExe(folder, depth){
  var best = null, bestSize = -1;
  try {
    var fc = new Enumerator(folder.Files);
    for (; !fc.atEnd(); fc.moveNext()) {
      var f = fc.item();
      if (!/\.exe$/i.test(f.Name)) { continue; }
      if (/^(unins|setup|vcredist|install|update|crash|report)/i.test(f.Name)) { continue; }
      if (f.Size > bestSize) { best = f; bestSize = f.Size; }
    }
    if (depth > 0) {
      var sc = new Enumerator(folder.SubFolders);
      for (; !sc.atEnd(); sc.moveNext()) {
        var r = biggestExe(sc.item(), depth - 1);
        if (r && r.Size > bestSize) { best = r; bestSize = r.Size; }
      }
    }
  } catch (e) {}
  return best;
}

function launchTarget(folder){
  /* A batch file sitting at the top of a tool folder is there to set
     something up before the exe runs, so it outranks the exe. */
  try {
    var fc = new Enumerator(folder.Files);
    for (; !fc.atEnd(); fc.moveNext()) {
      var f = fc.item();
      if (/\.(bat|cmd)$/i.test(f.Name)) { return f; }
    }
  } catch (e) {}
  return biggestExe(folder, 2);
}

function discover(){
  var seen = knownFolders(), found = [];
  try {
    var root = fso.GetFolder(BASE + "\\Tools");
    var e = new Enumerator(root.SubFolders);
    for (; !e.atEnd(); e.moveNext()) {
      var d = e.item();
      if (seen[d.Name.toLowerCase()]) { continue; }
      /* Firmware images are not programs and must never be offered as
         something to click. */
      if (/^BIOS-/i.test(d.Name)) { continue; }
      var t = launchTarget(d);
      if (!t) { continue; }
      found[found.length] = [d.Name, t.Path.substring(BASE.length + 1),
        "Added to this stick, not part of the kit",
        "Found in Tools\\" + d.Name + " and listed automatically, so it runs without anyone editing the launcher. Add an entry in Lazarus.hta to give it a category, a proper description and a licence pin.",
        "found", "t-info"];
    }
  } catch (e) {}
  return found;
}

function build(){
  var html = "", idx = 0, miss = 0;
  /* Discovered tools are appended as their own group rather than folded
     into a real category, because a guess must never be indistinguishable
     from something that was checked and written down. */
  var groups = DATA, extra = discover();
  if (extra.length) { groups = DATA.concat([["Found in the Tools folder", extra]]); }
  for (var g = 0; g < groups.length; g++) {
    var grp = groups[g], kids = "";
    var isIso = (grp[0] === "Boot ISOs");
    for (var i = 0; i < grp[1].length; i++) {
      var t = grp[1][i];
      var ok = fso.FileExists(BASE + "\\" + t[1]);
      if (!ok) { miss++; }
      FLAT[FLAT.length] = { g:grp[0], n:t[0], rel:t[1], f:t[2], d:t[3], tag:t[4], tc:t[5], ok:ok, iso:isIso };
      var pin = t[4] ? '<span class="pin" title="' + tagTitle(t[4]) + '">' + t[4] + '</span>' : '';
      kids += '<div class="leaf' + (ok?'':' gone') + '" id="lf' + idx + '"'
            + ' data-f="' + (t[0]+" "+t[2]+" "+t[3]).toLowerCase().replace(/"/g,'') + '"'
            + ' onclick="pick(' + idx + ')" ondblclick="go()">'
            + pin + iconTag(t[0], "ico") + t[0] + '</div>';
      idx++;
    }
    html += '<div class="grp" onclick="tog(' + g + ')">'
          + '<span class="chev" id="cv' + g + '">&#9660;</span> ' + grp[0]
          + '<span class="gc">' + grp[1].length + '</span></div>'
          + '<div class="kids" id="kd' + g + '">' + kids + '</div>';
  }
  document.getElementById("tree").innerHTML = html;
  storage(miss);
}

function storage(miss){
  try {
    var drv = fso.GetDrive(fso.GetDriveName(BASE));
    var total = drv.TotalSize, used = total - drv.FreeSpace;
    var pct = Math.round((used / total) * 1000) / 10;
    var bar = document.getElementById("bar");
    bar.style.width = pct + "%";
    bar.className = (pct > 90) ? "full" : ((pct > 75) ? "warn" : "");
    document.getElementById("statl").innerHTML =
      "<b>" + fmt(used) + "</b> used of " + fmt(total) + "  &middot;  <b>" + pct + "%</b>";
    document.getElementById("statr").innerHTML =
      "<b>" + FLAT.length + "</b> tools" + (miss ? "  &middot;  " + miss + " missing" : "");
  } catch (e) { document.getElementById("statl").innerHTML = "drive info unavailable"; }
}

function tog(g){
  var k = document.getElementById("kd"+g), c = document.getElementById("cv"+g);
  if (k.className.indexOf("cl") > -1) { k.className="kids"; c.innerHTML="&#9660;"; }
  else { k.className="kids cl"; c.innerHTML="&#9654;"; }
}

/* Pull one table literal out of our own source. String-aware, so a bracket
   inside a description cannot end the slice early. Returns null if not found. */
function sliceTable(src, name, open, close){
  var start = src.indexOf("var " + name + " = " + open);
  if (start === -1) { return null; }
  var from = src.indexOf(open, start);
  var depth = 0, inStr = null, esc = false;
  for (var i = from; i < src.length; i++) {
    var c = src.charAt(i);
    if (inStr) {
      if (esc) { esc = false; }
      else if (c === "\\") { esc = true; }
      else if (c === inStr) { inStr = null; }
      continue;
    }
    if (c === '"' || c === "'") { inStr = c; continue; }
    if (c === open) { depth++; }
    else if (c === close) { depth--; if (depth === 0) { return src.substring(from, i + 1); } }
  }
  return null;
}

/* JSON.parse first: all three tables are strict JSON, and it cannot execute
   anything. eval is a fallback only, for a hand-edit that leaves valid JS but
   invalid JSON (a trailing comma, a single-quoted string). The input is this
   file, which mshta is already executing, so the fallback adds no reach. */
function parseTable(txt){
  try { return JSON.parse(txt); } catch (e) {}
  try { return eval("(" + txt + ")"); } catch (e) {}
  return null;
}

/* Re-read our own tables off the stick. This is what makes Refresh mean
   "re-read the stick" rather than "re-walk what was loaded at startup":
   edit DATA or TAGDEF, press Refresh, and the change is live.
   Any failure leaves the in-memory tables untouched and reports false.

   The icon table used to be re-read here too. There is no icon table any
   more: icons are found by slug on disk, so the icon cache is refreshed
   by clearing ICONHIT rather than by parsing anything. */
function reloadTables(){
  try {
    var f = fso.OpenTextFile(BASE + "\\Lazarus.hta", 1);
    var txt = f.ReadAll();
    f.Close();
    var d = sliceTable(txt, "DATA", "[", "]");
    var t = sliceTable(txt, "TAGDEF", "{", "}");
    if (!d || !t) { return false; }
    var nd = parseTable(d), nt = parseTable(t);
    if (!nd || !nt || !nd.length) { return false; }
    DATA = nd; TAGDEF = nt;
    ICONHIT = {};
    return true;
  } catch (e) { return false; }
}

/* Re-scan: re-read the tables from disk, re-test every file, recompute sizes
   (cache cleared) and re-read free space. The button turns red briefly if the
   re-read failed, so a silent half-refresh is never mistaken for a real one. */
function refresh(){
  var b = document.getElementById("rfsh");
  b.className = "busy";
  var before = FLAT.length;
  var ok = reloadTables();
  FLAT = []; SZCACHE = {}; SEL = -1;
  build();
  document.getElementById("body").style.display = "none";
  document.getElementById("empty").style.display = "";
  filter(null);

  /* Say what just happened, in the footer, for 2.6s.
     Without this the button flashes for 350ms and the list looks identical
     whenever nothing changed on disk, which is indistinguishable from broken.
     build() has already run storage(), so the text captured here is the
     freshly-rebuilt one to restore afterwards. */
  var after = FLAT.length, delta = after - before;
  var sr = document.getElementById("statr");
  var normal = sr.innerHTML;
  if (!ok) {
    sr.innerHTML = "<span style='color:#9d1f18'>re-read failed</span>";
  } else if (delta === 0) {
    sr.innerHTML = "re-read <b>" + after + "</b>, no change";
  } else {
    sr.innerHTML = "re-read <b>" + after + "</b> (" + (delta > 0 ? "+" : "") + delta + ")";
  }

  window.setTimeout(function(){
    var r = document.getElementById("rfsh");
    r.className = ok ? "" : "stale";
    r.title = ok ? "Re-scan the drive and rebuild this list"
                 : "Re-read of Lazarus.hta failed. Showing the tables loaded at startup.";
  }, 350);
  window.setTimeout(function(){
    var s = document.getElementById("statr");
    if (s) { s.innerHTML = normal; }
  }, 2600);
}

function pick(i){
  if (SEL > -1) { var o = document.getElementById("lf"+SEL); if (o) { o.className = o.className.replace(" sel",""); } }
  SEL = i;
  var el = document.getElementById("lf"+i);
  if (el && el.className.indexOf("sel") === -1) { el.className += " sel"; }

  document.getElementById("empty").style.display = "none";
  document.getElementById("body").style.display = "";

  var t = FLAT[i];
  var tag = t.tag ? '<span class="tag '+t.tc+'" title="'+tagTitle(t.tag)+'">'+t.tag+'</span>' : '';
  document.getElementById("dn").innerHTML = iconTag(t.n, "bigico") + t.n + tag;
  document.getElementById("dfor").innerHTML = t.f;
  document.getElementById("dd").innerHTML = t.d;

  var sz = toolSize(t);
  document.getElementById("dmeta").innerHTML =
      (sz >= 0 ? "<b>" + fmt(sz) + "</b> on the drive" : "size unavailable")
    + (t.ok ? "" : "  &middot;  <span style='color:#9d1f18'>FILE MISSING</span>");
  document.getElementById("dpath").innerHTML = t.rel;

  var btn = t.iso ? '<span id="run" class="dead">Reboot &rarr; Ventoy</span>'
                  : (t.ok ? '<span id="run" onclick="go()">Launch</span>'
                          : '<span id="run" class="dead">Not found</span>');
  document.getElementById("drow").innerHTML =
    '<span id="dexp" onclick="reveal()">Open folder</span>' + btn;
}

/* ---------------------------------------------------------------------------
   RUN AS ADMINISTRATOR, for every tool at once.

   A locked-down machine typically applies AppLocker allowing %WINDIR%
   and %PROGRAMFILES% for Everyone and everything else for
   Administrators only. A removable drive is neither, so every tool on
   this stick is blocked on such a machine.

   Being signed in as an administrator is NOT enough. Under UAC an
   ordinary process carries the Administrators SID as deny-only, so the
   "Administrators Allow" rule does not match, and Windows blocks the
   program before it can run the code that asks to elevate. The window
   opens and shuts in a millisecond.

   shell.Run cannot elevate. Shell.Application's ShellExecute with the
   "runas" verb can, so the toggle picks between them.

   The setting is remembered on the stick, so it survives closing the
   launcher and travels to the next laptop with it.
   --------------------------------------------------------------------------- */
/* ON BY DEFAULT. The file records the OFF state, not the on state, so
   a fresh stick elevates without anyone having to know why. On a
   locked-down laptop AppLocker blocks everything run from this stick
   unless it is elevated, so off-by-default would mean the tools appear
   broken on exactly the machines they are for. */
var ADMIN_OFF_FLAG = BASE + "\\Docs\\admin-off.flag";
var RUNADMIN = true;
try { RUNADMIN = !fso.FileExists(ADMIN_OFF_FLAG); } catch (e) { RUNADMIN = true; }

function paintAdmin(){
  var w = document.getElementById("admwrap");
  if (!w) { return; }
  w.className = RUNADMIN ? "on" : "";
}

function toggleAdmin(){
  RUNADMIN = !RUNADMIN;
  /* Persisted as a file rather than in memory: the whole point is that
     you set it once on a laptop where the stick is blocked, and it is
     still set for the next tool and the next machine. */
  try {
    if (RUNADMIN) {
      if (fso.FileExists(ADMIN_OFF_FLAG)) { fso.DeleteFile(ADMIN_OFF_FLAG); }
    } else {
      var f = fso.CreateTextFile(ADMIN_OFF_FLAG, true);
      f.WriteLine("The ADMIN slider in Lazarus is OFF, so tools launch normally.");
      f.WriteLine("Delete this file, or click the slider again, to turn it back on.");
      f.Close();
    }
  } catch (e) {
    /* A read-only stick must not silently pretend the setting stuck.
       It still works for this session, and says so. */
    alert("The setting could not be saved to the stick, so it applies to this session only.\n\n" + e.message);
  }
  paintAdmin();
}

function go(){
  var t = FLAT[SEL];
  if (!t || t.iso) { return; }
  var full = BASE + "\\" + t.rel;
  if (!fso.FileExists(full)) { alert("Not found:\n\n" + full); return; }
  var dir = full.substring(0, full.lastIndexOf("\\"));
  try {
    if (RUNADMIN) {
      /* "runas" raises the UAC prompt. Cancelling it throws, which is a
         normal answer and not a fault, so it is reported gently. */
      var sa = new ActiveXObject("Shell.Application");
      sa.ShellExecute(full, "", dir, "runas", 1);
    } else {
      shell.CurrentDirectory = dir;
      shell.Run('"' + full + '"', 1, false);
    }
  } catch (e) {
    if (RUNADMIN) {
      alert("Could not start it as administrator.\n\n" + full +
            "\n\nIf you clicked No on the prompt, that is all this is." +
            "\n\n" + e.message);
    } else {
      alert("Could not launch:\n\n" + full + "\n\n" + e.message +
            "\n\nIf this machine is locked down, its AppLocker policy" +
            "\nblocks programs run from this stick. Turn ADMIN on, top right.");
    }
  }
}

function reveal(){
  var t = FLAT[SEL];
  if (!t) { return; }
  try { shell.Run('explorer.exe /select,"' + BASE + "\\" + t.rel + '"', 1, false); } catch (e) {}
}

/* ---------------------------------------------------------------------------
   Eject. Three problems this has to solve:
   1. Anything still running FROM the stick blocks the eject and risks
      corruption. Find those and name them, rather than letting Windows throw
      its useless "device is in use" box.
   2. This launcher itself holds a handle on Lazarus.hta, so it cannot eject
      the drive it is reading from. The helper is written to %TEMP% (off the
      stick), so it survives us closing.
   3. If the direct eject is still refused, fall back to opening Windows'
      Safely Remove Hardware dialog so the user is never stuck.
--------------------------------------------------------------------------- */
function driveLetter(){ return BASE.substring(0, 2).toUpperCase(); }

function busyProcesses(){
  var hits = [], seen = {};
  var drv = driveLetter();
  try {
    var wmi = GetObject("winmgmts:\\\\.\\root\\cimv2");
    var e = new Enumerator(wmi.ExecQuery("SELECT Name,ExecutablePath FROM Win32_Process"));
    for (; !e.atEnd(); e.moveNext()) {
      var p = e.item();
      var path = p.ExecutablePath;
      if (path && path.length > 1 && path.substring(0, 2).toUpperCase() === drv) {
        if (!seen[p.Name]) { seen[p.Name] = 1; hits[hits.length] = p.Name; }
      }
    }
  } catch (err) { /* WMI unavailable: fall through and let Windows decide */ }
  return hits;
}

function eject(){
  var drv = driveLetter();
  var busy = busyProcesses();
  if (busy.length) {
    alert("Cannot eject " + drv + " yet.\n\n"
        + "These are still running from the drive:\n\n    "
        + busy.join("\n    ")
        + "\n\nClose them, then press Eject again.");
    return;
  }
  // Tell them to check in Windows afterwards as well.
  //
  // This eject asks the shell to release the drive and reports what it
  // was told. What it CANNOT see is a handle opened by something outside
  // the list it checks: an antivirus mid-scan, an indexer, a file still
  // open in an editor. Any of those make the shell report success while
  // the volume is not actually safe to pull.
  //
  // Belt and braces is the honest advice for removable media: use this,
  // then confirm with Windows' own Safely Remove Hardware. Losing a
  // stick full of client reports to a half-finished write is not worth
  // trusting a single signal.
  if (!confirm("Eject " + drv + " ?\n\n"
      + "Lazarus will close, then the drive is released.\n\n"
      + "RECOMMENDED: after this finishes, also use Windows' own\n"
      + "Safely Remove Hardware icon in the system tray as a second\n"
      + "check before pulling the stick out. This cannot see every\n"
      + "handle another program might still be holding.")) { return; }

  var b = document.getElementById("ejectbtn");
  b.className = "busy"; b.innerHTML = "OUT";

  try {
    var tmp = shell.ExpandEnvironmentStrings("%TEMP%") + "\\lazarus_eject.vbs";
    var f = fso.CreateTextFile(tmp, true);
    f.WriteLine("' written by Lazarus. Runs off the stick so it outlives the launcher.");
    f.WriteLine("On Error Resume Next");
    f.WriteLine("WScript.Sleep 1500");
    f.WriteLine("Set sh   = CreateObject(\"Shell.Application\")");
    f.WriteLine("Set fsov = CreateObject(\"Scripting.FileSystemObject\")");
    f.WriteLine("gone = False");
    f.WriteLine("For attempt = 1 To 3");
    f.WriteLine("  For Each it In sh.Namespace(17).Items");
    f.WriteLine("    If UCase(Left(it.Path, 2)) = UCase(\"" + drv + "\") Then");
    f.WriteLine("      it.InvokeVerb \"Eject\"");
    f.WriteLine("      For Each vb In it.Verbs");
    f.WriteLine("        If InStr(LCase(Replace(vb.Name, \"&\", \"\")), \"ject\") > 0 Then vb.DoIt");
    f.WriteLine("      Next");
    f.WriteLine("    End If");
    f.WriteLine("  Next");
    f.WriteLine("  WScript.Sleep 1400");
    f.WriteLine("  If Not fsov.DriveExists(\"" + drv + "\") Then");
    f.WriteLine("    gone = True");
    f.WriteLine("    Exit For");
    f.WriteLine("  End If");
    f.WriteLine("Next");
    f.WriteLine("If Not gone Then");
    f.WriteLine("  MsgBox \"Windows would not release " + drv + " yet.\" & vbCrLf & vbCrLf & _");
    f.WriteLine("    \"Something still has a file or folder open on the stick.\" & vbCrLf & _");
    f.WriteLine("    \"Close any Explorer window showing the drive, then try again.\" & vbCrLf & vbCrLf & _");
    f.WriteLine("    \"If it still refuses, the tray icon for Safely Remove Hardware\" & vbCrLf & _");
    f.WriteLine("    \"will name whatever is holding it.\", 48, \"Lazarus\"");
    f.WriteLine("End If");
    f.WriteLine("fsov.DeleteFile WScript.ScriptFullName, True");
    f.Close();
    shell.Run("wscript.exe \"" + tmp + "\"", 0, false);
    window.close();
  } catch (e) {
    b.className = ""; b.innerHTML = "&#9167;";
    alert("Could not start the eject helper:\n\n" + e.message
        + "\n\nUse the Safely Remove Hardware icon in the system tray instead.");
  }
}

function filter(ev){
  if (ev && ev.keyCode === 27) { document.getElementById("search").value = ""; }
  var q = document.getElementById("search").value.toLowerCase();
  for (var i = 0; i < FLAT.length; i++) {
    var el = document.getElementById("lf"+i);
    if (!el) { continue; }
    el.style.display = (q === "" || el.getAttribute("data-f").indexOf(q) > -1) ? "" : "none";
  }
  for (var g = 0; g < DATA.length; g++) {
    var k = document.getElementById("kd"+g), c = document.getElementById("cv"+g);
    if (q !== "" && k.className.indexOf("cl") > -1) { k.className="kids"; c.innerHTML="&#9660;"; }
  }
}

window.onload = function(){
  var w = 440, h = 880;
  try { var mh = screen.availHeight - 40; if (h > mh) { h = mh; } } catch (e) {}
  window.resizeTo(w, h);
  try { window.moveTo(screen.availWidth - w - 14, screen.availHeight - h - 14); } catch (e) {}
  build();
  /* PAINT THE ADMIN BUTTON ON LOAD, not only when it is clicked.
     The setting is remembered in a file on the stick, so reopening
     the launcher with it left ON would otherwise show OFF while
     every tool silently elevated. A control that misreports what it
     is doing is worse than no control. */
  paintAdmin();
};
</script>
</body>
</html>
